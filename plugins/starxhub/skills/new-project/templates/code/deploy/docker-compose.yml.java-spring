services:
  mysql:
    image: mysql:8.0
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_PASSWORD:-your_password}
      MYSQL_DATABASE: your_db
    ports:
      - "3306:3306"
    volumes:
      - mysql-data:/var/lib/mysql

  api:
    build:
      context: .
      dockerfile: src/backend/api/Dockerfile.api
    depends_on:
      - mysql
    environment:
      SPRING_PROFILES_ACTIVE: prod
      DB_URL: jdbc:mysql://mysql:3306/your_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
      DB_USERNAME: root
      DB_PASSWORD: ${DB_PASSWORD:-your_password}
      JWT_SECRET: ${JWT_SECRET:-replace-me}
      JAVA_OPTS: "-Xmx512m"
    ports:
      - "8080:8080"

  web:
    build:
      context: .
      dockerfile: src/backend/web/Dockerfile.web
    depends_on:
      - api
    ports:
      - "8081:80"

volumes:
  mysql-data:
