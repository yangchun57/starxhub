# 本地编排（Python FastAPI 后端）：默认使用内置 SQLite，MySQL 服务按需启用
# 用法：docker compose up -d --build
# 切到 MySQL：给 api 增加 DATABASE_URL=mysql+pymysql://root:your_password@mysql:3306/your_db

services:
  mysql:
    image: mysql:8.0
    profiles: ["mysql"]
    environment:
      MYSQL_ROOT_PASSWORD: your_password
      MYSQL_DATABASE: your_db
    ports:
      - "3306:3306"
    volumes:
      - mysql-data:/var/lib/mysql

  api:
    build:
      context: .
      dockerfile: src/backend/api/Dockerfile.api
    environment:
      - PYTHONUNBUFFERED=1
    ports:
      - "8000:8000"

  web:
    build:
      context: .
      dockerfile: src/backend/web/Dockerfile.web
    depends_on:
      - api
    ports:
      - "80:80"

volumes:
  mysql-data:
