name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  gate:
    name: 质量门禁（复用本地 scripts/ci.sh）
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Setup JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
          cache: maven
      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Run local gate
        run: bash scripts/ci.sh
